LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional overrides
# DB_PATH=data/collectwise.db     # SQLite file (:memory: for ephemeral)
# LLM_MODEL=openai/gpt-4.1-mini   # LiveKit Inference LLM for the agent
# STT_MODEL=assemblyai/universal-3-5-pro # try deepgram/nova-3 if numbers transcribe poorly
# TRACE_DIR=logs                  # Where per-call JSONL traces are written

# Mock caller ID for local/browser testing. Real telephony calls carry the
# caller's number as the sip.phoneNumber participant attribute; when that is
# absent, this value is used instead. Try a seed number (555-010-4821 = Maria
# Gonzalez) for the recognized-caller path, or any other number for the
# unknown-caller path. Leave unset to always ask for the account number.
# INCOMING_NUMBER=+15550104821
