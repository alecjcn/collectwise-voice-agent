# Copy this file to .env.local and fill in the REQUIRED values below.
#   cp .env.example .env.local
# (.env.local is gitignored. `lk cloud auth && lk app env -w -d .env.local`
#  writes the three required values for you.)

# ── Required: your own LiveKit Cloud project credentials ──
# Found at cloud.livekit.io -> your project -> Settings. The agent and the LLM
# evals both run models through LiveKit Inference on this project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Optional: everything below has a sensible default; uncomment to override ──

# Caller-ID path. On real telephony the caller's number arrives as the
# sip.phoneNumber attribute; off telephony (console/browser/local) there is no
# such number, so to TEST the recognized-caller path you must set it here in
# .env.local. Use a seed account's number for right-party confirmation
# ("Am I speaking with Maria Gonzalez?"), or any other number for the
# unknown-caller path. Left unset, the agent always asks for the account number.
#   Seed numbers: 555-010-4821 Maria | ...-3390 David | ...-7712 Sarah |
#                 ...-6655 James (in dispute) | ...-2218 Linda (paid)
# INCOMING_NUMBER=+15550104821

# Models & voice (LiveKit Inference). Prompts and eval intents are tuned
# against the LLM_MODEL / JUDGE_MODEL defaults below - change with care.
# LLM_MODEL=openai/gpt-4.1-mini          # agent LLM
# JUDGE_MODEL=openai/gpt-4.1-mini        # eval judge
# STT_MODEL=assemblyai/universal-3-5-pro # try deepgram/nova-3 if digits transcribe poorly
# TTS_MODEL=fishaudio/s2.1-pro           # TTS_VOICE selects the voice for this model
# TTS_VOICE=9a9cf47702da476aa4629e2506d4a857

# Storage & tracing
# DB_PATH=data/collectwise.db  # SQLite file (:memory: for ephemeral)
# TRACE_DIR=logs               # where per-call JSONL traces are written
